{
	"compilerOptions": {
		"target": "es2015",
		"module": "commonjs",
		"rootDir": "src",
		"outDir": "dist",
		"noImplicitAny": false,
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"declaration": true,
		"declarationDir": "declarations",
		"sourceMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
